@model IList<Product>


	<div class="container">
		<table class="table table-striped table-hover">
			<thead>
				<tr>
					<th>Id</th>
					<th>Product Name</th>
					<th>Category</th>
					<th>Price</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var product in Model)
				{
					<tr>
						<td>@product.Id</td>
						<td>@product.ProductName</td>
						<td>@product.Category</td>
						<td>@product.Price</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
