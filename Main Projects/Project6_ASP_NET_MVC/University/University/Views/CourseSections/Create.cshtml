@model CourseSection
@{
    ViewData["Title"] = "Course Section";
}


<div class="container">
    <h1>Create Course Section</h1>
    <form asp-action="Create" method="post">
        <div class="text-danger" asp-validation-summary="All"></div>


        <div class="form-group">
            <label class="control-label">Course Id</label>
            <input asp-for="CourseId" class="form-control" />
            <span asp-validation-for="CourseId" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label class="control-label">Semester</label>
            <input asp-for="Semester" class="form-control" />
            <span asp-validation-for="Semester" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label class="control-label">Section Number</label>
            <input asp-for="SectionNumber" class="form-control" />
            <span asp-validation-for="SectionNumber" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label class="control-label">Max Capacity</label>
            <input asp-for="MaxCapacity" class="form-control" />
            <span asp-validation-for="MaxCapacity" class="text-danger"></span>
        </div>


        <div class="form-group mt-2">
            <label class="control-label fw-bold">Days Of Week</label>
            <div class="d-flex gap-3 my-1">
                <div class="form-check"><input type="checkbox" class="day-checkbox form-check-input" value="M" /> M</div>
                <div class="form-check"><input type="checkbox" class="day-checkbox form-check-input" value="T" /> T</div>
                <div class="form-check"><input type="checkbox" class="day-checkbox form-check-input" value="W" /> W</div>
                <div class="form-check"><input type="checkbox" class="day-checkbox form-check-input" value="TH" /> TH</div>
                <div class="form-check"><input type="checkbox" class="day-checkbox form-check-input" value="F" /> F</div>
            </div>
            <input type="hidden" asp-for="DaysOfWeek" id="DaysOfWeekInput" />
            <span asp-validation-for="DaysOfWeek" class="text-danger"></span>
        </div>

        <div class="form-group mt-2">
            <label class="control-label fw-bold">Time Slot</label>
            <div class="row">
                <div class="col">
                    <label class="small text-muted">Start Time</label>
                    <input type="time" id="StartTime" class="form-control" />
                </div>
                <div class="col">
                    <label class="small text-muted">End Time</label>
                    <input type="time" id="EndTime" class="form-control" />
                </div>
            </div>
            <input type="hidden" asp-for="TimeSlot" id="TimeSlotInput" />
            <span asp-validation-for="TimeSlot" class="text-danger"></span>
        </div>


        <div class="form-group">
            <input type="submit" value="Create" class="btn btn-primary mt-3 mb-3" />
        </div>
    </form>
    <div>
        <a asp-action="Index">Back to List</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.querySelectorAll('.day-checkbox').forEach(chk => {
            chk.addEventListener('change', () => {
                const selected = Array.from(document.querySelectorAll('.day-checkbox:checked'))
                                      .map(cb => cb.value)
                                      .join('');
                document.getElementById('DaysOfWeekInput').value = selected;
            });
        });




        function updateTimeSlot() {
            const start = document.getElementById('StartTime').value;
            const end = document.getElementById('EndTime').value;

            if (start && end) {
                const formatTime = (t) => {
                    let [h, m] = t.split(':');
                    let period = h >= 12 ? 'PM' : 'AM';
                    h = h % 12 || 12;
                    return `${String(h).padStart(2, '0')}:${m} ${period}`;
                };
                document.getElementById('TimeSlotInput').value = `${formatTime(start)} - ${formatTime(end)}`;
            }
        }

        document.getElementById('StartTime').addEventListener('change', updateTimeSlot);
        document.getElementById('EndTime').addEventListener('change', updateTimeSlot);
    </script>
}
