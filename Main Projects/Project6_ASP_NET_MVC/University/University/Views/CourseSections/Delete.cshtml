@model CourseSection

@{
    ViewData["Title"] = "Delete Course Section";
}

<div class="container">
    <h1>Delete Course Section</h1>
    <form asp-action="Delete" method="post">





        <div class="form-group">
            <label asp-for="CourseId" class="control-label"></label>
            <input asp-for="CourseId" class="form-control" readonly />
        </div>
        <div class="form-group">
            <label asp-for="Semester" class="control-label"></label>
            <input asp-for="Semester" class="form-control" readonly />
        </div>
        <div class="form-group">
            <label asp-for="SectionNumber" class="control-label"></label>
            <input asp-for="SectionNumber" class="form-control" readonly />
        </div>

        <div class="form-group">
            <label asp-for="MaxCapacity" class="control-label"></label>
            <input asp-for="MaxCapacity" class="form-control" readonly />
        </div>
        <div class="form-group">
            <label asp-for="DaysOfWeek" class="control-label"></label>
            <input asp-for="DaysOfWeek" class="form-control" readonly />
        </div>
        <div class="form-group">
            <label asp-for="TimeSlot" class="control-label"></label>
            <input asp-for="TimeSlot" class="form-control" readonly />
        </div>




        <div class="form-group">
            <input type="submit" value="Delete" class="btn btn-danger" />
        </div>
    </form>
    <div>
        <a asp-action="Index">Back to List</a>
    </div>
</div>
