@using University.Application.Dtos
@model DegreeRequirementUpdateDto

@{
    ViewData["Title"] = "Edit Degree Requirements";
}

<div class="container-fluid px-4 py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-warning text-dark py-3 px-4 rounded-top-4">
                    <h4 class="mb-0 fw-bold"><i class="fas fa-edit me-2"></i> Edit Degree Requirements</h4>
                </div>
                <div class="card-body p-4 p-sm-5">
                    <form asp-action="Edit" asp-route-Uuid="@Model.Uuid" method="post">
                        <div class="text-danger small mb-3" asp-validation-summary="All"></div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-dark">Degree Program ID</label>
                            <input asp-for="DegreeProgramId" class="form-control rounded-3" />
                            <span asp-validation-for="DegreeProgramId" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-dark">Category Name</label>
                            <input asp-for="CategoryName" class="form-control rounded-3" />
                            <span asp-validation-for="CategoryName" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold text-dark">Required Credits</label>
                                <input asp-for="RequiredCredits" class="form-control rounded-3" />
                                <span asp-validation-for="RequiredCredits" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold text-dark">Minimum Level</label>
                                <input asp-for="MinLevel" class="form-control rounded-3" />
                                <span asp-validation-for="MinLevel" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex align-items-center justify-content-between mt-4">
                            <a asp-action="Index" class="text-muted text-decoration-none fw-semibold"><i class="fas fa-arrow-left me-1"></i> Back to List</a>
                            <input type="submit" value="Update Requirement" class="btn btn-warning px-4 py-2 rounded-3 fw-bold text-dark" />
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}