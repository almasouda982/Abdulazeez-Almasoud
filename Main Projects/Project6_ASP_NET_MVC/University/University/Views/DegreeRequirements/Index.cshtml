@using University.Application.Dtos
@model IEnumerable<DegreeRequirementDto>

@{
    ViewData["Title"] = "Degree Requirements Management";
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Degree Requirements</h2>
            <p class="text-muted small mb-0">Define category minimum credits and level thresholds for programs.</p>
        </div>
        <a asp-action="Create" class="btn btn-indigo text-white px-3 py-2 rounded-3 fw-bold shadow-sm" style="background-color: #4f46e5;">
            <i class="fas fa-plus-circle me-2"></i> New Degree Requirement
        </a>
    </div>

    <div class="card border-0 rounded-4 shadow-sm overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-uppercase fs-7 text-muted">
                        <tr>
                            <th class="py-3 ps-4">Id</th>
                            <th class="py-3">Degree Program Name</th>
                            <th class="py-3">Category Name</th>
                            <th class="py-3">Required Credits</th>
                            <th class="py-3">Minimum Level</th>
                            <th class="py-3 pe-4 text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var degreeReq in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold text-secondary">@degreeReq.Id</td>
                                <td>
                                    <span class="badge px-2 py-1 rounded-2" style="background-color: rgba(79, 70, 229, 0.1); color: #4f46e5;">@degreeReq.Name</span>
                                </td>
                                <td class="fw-bold text-dark">@degreeReq.CategoryName</td>
                                <td>
                                    <span class="badge bg-light text-dark border px-2 py-1 fw-semibold">@degreeReq.RequiredCredits</span>
                                </td>
                                <td>
                                    <span class="badge bg-secondary-subtle text-dark px-2 py-1">Level @degreeReq.MinLevel</span>
                                </td>
                                <td class="pe-4 text-end">
                                    <div class="btn-group" role="group">
                                        <a asp-action="Edit" asp-route-Uuid="@degreeReq.Uuid" class="btn btn-sm btn-outline-warning rounded-start-3 px-2 py-1" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-Uuid="@degreeReq.Uuid" class="btn btn-sm btn-outline-danger rounded-end-3 px-2 py-1" title="Delete">
                                            <i class="fas fa-trash-alt"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>