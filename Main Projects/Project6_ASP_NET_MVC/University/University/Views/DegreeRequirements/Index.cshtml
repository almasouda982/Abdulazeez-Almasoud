@model IEnumerable<DegreeRequirement>

<div class="container">

    <h1>Degree Requirement</h1>

    <div class="text-end">
        <a asp-action="Create" class="btn btn-primary mb-3">New Degree Requirement</a>
    </div>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Category Name</th>
                <th>Required Credits</th>
                <th>Minimum Level</th>
                <th>Actions</th>

            </tr>
        </thead>
        <tbody>
            @foreach (var degreeReq in Model)
            {

                <tr>
                    <td>@degreeReq.Id</td>
                    <td>@degreeReq.CategoryName</td>
                    <td>@degreeReq.RequiredCredits</td>
                    <td>@degreeReq.MinLevel</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@degreeReq.Id" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-action="Delete" asp-route-id="@degreeReq.Id" class="btn btn-sm btn-danger">Delete</a>
                    </td>

                </tr>

            }


        </tbody>

    </table>
</div>
