@using University.Application.Dtos
@model CourseCreateDto
@{
    ViewData["Title"] = "Create Course";
}

<div class="container-fluid px-4 py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-indigo text-white py-3 px-4 rounded-top-4" style="background-color: #4f46e5;">
                    <h4 class="mb-0 fw-bold"><i class="fas fa-book-medical me-2"></i> Create New Course</h4>
                </div>
                <div class="card-body p-4 p-sm-5">
                    <form asp-action="Create" method="post">
                        <div class="text-danger small mb-3" asp-validation-summary="All"></div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold text-dark">Course Code</label>
                                <input asp-for="Code" class="form-control rounded-3" placeholder="e.g. CS101" />
                                <span asp-validation-for="Code" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold text-dark">Credits</label>
                                <input asp-for="Credits" class="form-control rounded-3" placeholder="e.g. 3" />
                                <span asp-validation-for="Credits" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-dark">Course Title</label>
                            <input asp-for="Title" class="form-control rounded-3" placeholder="e.g. Introduction to Computer Science" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold text-dark">Description</label>
                            <textarea asp-for="Description" class="form-control rounded-3" rows="4" placeholder="The type of course you are requesting"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="d-flex align-items-center justify-content-between mt-4">
                            <a asp-action="Index" class="text-muted text-decoration-none fw-semibold"><i class="fas fa-arrow-left me-1"></i> Back to List</a>
                            <input type="submit" value="Create Course" class="btn btn-indigo px-4 py-2 rounded-3 fw-bold text-white" style="background-color: #4f46e5;" />
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}