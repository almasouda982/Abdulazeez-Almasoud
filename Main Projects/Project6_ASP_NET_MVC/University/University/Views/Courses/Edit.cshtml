@using University.Application.Dtos
@model CourseUpdateDto

@{
    ViewData["Title"] = "Edit Course";
}

<div class="container-fluid px-4 py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-warning text-dark py-3 px-4 rounded-top-4">
                    <h4 class="mb-0 fw-bold"><i class="fas fa-book-open me-2"></i> Edit Course</h4>
                </div>
                <div class="card-body p-4 p-sm-5">
                    <form asp-action="Edit" asp-route-Uuid="@Model.Uuid" method="post">
                        <div class="text-danger small mb-3" asp-validation-summary="All"></div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Code" class="form-label fw-semibold text-dark">Course Code</label>
                                <input asp-for="Code" class="form-control rounded-3" />
                                <span class="text-danger small" asp-validation-for="Code"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Credits" class="form-label fw-semibold text-dark">Credits</label>
                                <input asp-for="Credits" class="form-control rounded-3" />
                                <span class="text-danger small" asp-validation-for="Credits"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-semibold text-dark">Course Title</label>
                            <input asp-for="Title" class="form-control rounded-3" />
                            <span class="text-danger small" asp-validation-for="Title"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Description" class="form-label fw-semibold text-dark">Description</label>
                            <textarea asp-for="Description" class="form-control rounded-3" rows="4"></textarea>
                            <span class="text-danger small" asp-validation-for="Description"></span>
                        </div>

                        <div class="d-flex align-items-center justify-content-between mt-4">
                            <a asp-action="Index" class="text-muted text-decoration-none fw-semibold"><i class="fas fa-arrow-left me-1"></i> Back to List</a>
                            <input type="submit" value="Update Course" class="btn btn-warning px-4 py-2 rounded-3 fw-bold text-dark" />
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}