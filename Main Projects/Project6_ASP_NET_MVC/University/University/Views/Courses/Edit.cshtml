@model Course

@{
	ViewData["Title"] = "Edit Course";
}

<div class="container">
    <h1>Edit Course</h1>
    <form asp-action="Edit" method="post">

        <div class="text-danger" asp-validation-summary="All">
        </div>

        <div class="form-group">
            <label asp-for="Code" class="control-label"></label>
            <input asp-for="Code" class="form-control" />
            <span class="text-danger" asp-validation-for="Code"></span>

        </div>
        <div class="form-group">
            <label asp-for="Title" class="control-label"></label>
            <input asp-for="Title" class="form-control" />
            <span class="text-danger" asp-validation-for="Title"></span>

        </div>
        <div class="form-group">
            <label asp-for="Credits" class="control-label"></label>
            <input asp-for="Credits" class="form-control" />
            <span class="text-danger" asp-validation-for="Credits"></span>

        </div>
        <div class="form-group">
            <label asp-for="Description" class="control-label"></label>
            <textarea asp-for="Description" class="form-control"></textarea>

        </div>


        <div class="form-group">
            <input type="submit" value="Update" class="btn btn-warning" />
        </div>
    </form>
    <div>
        <a asp-action="Index">Back to List</a>
    </div>
</div>




@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
