@model Course

@{
	ViewData["Title"] = "Delete Course";
}

<div class="container">
    <h1>Delete Course</h1>
    <form asp-action="Delete" method="post">





        <div class="form-group">
            <label asp-for="Code" class="control-label"></label>
            <input asp-for="Code" class="form-control" readonly />
        </div>

        <div class="form-group">
            <label asp-for="Title" class="control-label"></label>
            <input asp-for="Title" class="form-control" readonly />
        </div>

        <div class="form-group">
            <label asp-for="Credits" class="control-label"></label>
            <input asp-for="Credits" class="form-control" readonly />
        </div>

        <div class="form-group">
            <label asp-for="Description" class="control-label"></label>
            <textarea asp-for="Description" class="form-control" readonly></textarea>
        </div>



        <div class="form-group">
            <input type="submit" value="Delete" class="btn btn-danger" />
        </div>
    </form>
    <div>
        <a asp-action="Index">Back to List</a>
    </div>
</div>
