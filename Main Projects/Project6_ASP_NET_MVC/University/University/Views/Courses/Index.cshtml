@model IEnumerable<University.Application.Dtos.CourseDto>

<div class="container">

    <h1>Courses</h1>

    <div class="text-end">
        <a asp-action="Create" class="btn btn-primary mb-3">New Course</a>
    </div>

    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Id</th>
                <th>Code</th>
                <th>Title</th>
                <th>Credits</th>
                <th>Description</th>
                <th>Stacked Textbooks</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var course in Model)
            {
                <tr>
                    <td>@course.Id</td>
                    <td>@course.Code</td>
                    <td>@course.Title</td>
                    <td>@course.Credits</td>
                    <td>@course.Description</td>
                    <td>
                        @if (course.Books != null && course.Books.Any())
                        {
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-info text-dark">@course.Books.Count() Book(s)</span>
                                <a asp-controller="CourseBooks" asp-action="Index" asp-route-courseId="@course.Id" class="btn btn-sm btn-outline-primary">Manage Books</a>
                            </div>
                        }
                        else
                        {
                            <span class="text-muted small">No Books Assigned </span>
                            <a asp-controller="CourseBooks" asp-action="Index" asp-route-courseId="@course.Id" class="btn btn-sm btn-outline-secondary ms-2">Add Books</a>
                        }
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-Uuid="@course.Uuid" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-action="Delete" asp-route-Uuid="@course.Uuid" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>