@model IEnumerable<Course>

<div class="container">

    <h1>Courses</h1>

    <div class="text-end">
        <a asp-action="Create" class="btn btn-primary mb-3">New Course</a>
    </div>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Code</th>
                <th>Title</th>
                <th>Credits</th>
                <th>Description</th>
                <th>Actions</th>

            </tr>
        </thead>
        <tbody>
            @foreach (var course in Model)
            {

                <tr>
                    <td>@course.Id</td>
                    <td>@course.Code</td>
                    <td>@course.Title</td>
                    <td>@course.Credits</td>
                    <td>@course.Description</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@course.Id" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-action="Delete" asp-route-id="@course.Id" class="btn btn-sm btn-danger">Delete</a>

                    </td>

                </tr>

            }


        </tbody>

    </table>
</div>
