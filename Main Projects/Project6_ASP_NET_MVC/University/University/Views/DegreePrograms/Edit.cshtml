@model DegreeProgram

@{
    ViewData["Title"] = "Edit Degree Program";
}

<div class="container">
    <h1>Edit Degree Program</h1>
    <form asp-action="Edit" method="post">

        <div class="text-danger" asp-validation-summary="All">
        </div>
        <div class="form-group">
            <label class="control-label">Name</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label class="control-label">Catalog Year</label>
            <input asp-for="CatalogYear" class="form-control" />
            <span asp-validation-for="CatalogYear" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label class="control-label">Total Credits Required</label>
            <input asp-for="TotalCreditsRequired" class="form-control" />
            <span asp-validation-for="TotalCreditsRequired" class="text-danger"></span>
        </div>



        <div class="form-group">
            <input type="submit" value="Update" class="btn btn-warning" />
        </div>
    </form>
    <div>
        <a asp-action="Index">Back to List</a>
    </div>
</div>




@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
