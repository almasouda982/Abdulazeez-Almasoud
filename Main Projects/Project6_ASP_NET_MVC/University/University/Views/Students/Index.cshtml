@model IEnumerable<Student>

<div class="container">

    <h1>Students</h1>

    <div class="text-end">
        <a asp-action="Create" class="btn btn-primary mb-3">New Student</a>
    </div>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Degree Program Id</th>
                <th>First Name</th>
                <th>Last Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Standing</th>
                <th>GPA</th>
                <th>EnrollmentStatus</th>
                <th>Action</th>

            </tr>
        </thead>
        <tbody>
            @foreach (var student in Model)
            {

                <tr>
                    <td>@student.Id</td>
                    <td>@student.DegreeProgramId</td>
                    <td>@student.FirstName</td>
                    <td>@student.LastName</td>
                    <td>@student.Email</td>
                    <td>@student.Phone</td>
                    <td>@student.Standing</td>
                    <td>@student.GPA</td>
                    <td>@(student.EnrollmentStatus ? "Enrolled" : "Not Enrolled")</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@student.Id" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-action="Delete" asp-route-id="@student.Id" class="btn btn-sm btn-danger">Delete</a>

                    </td>

                </tr>

            }


        </tbody>

    </table>
</div>
