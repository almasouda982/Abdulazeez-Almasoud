@using University.Application.Dtos
@model StudentUpdateDto

@{
    ViewData["Title"] = "Delete Student";
}

<div class="container-fluid px-4 py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-danger text-white py-3 px-4 rounded-top-4">
                    <h4 class="mb-0 fw-bold"><i class="fas fa-user-slash me-2"></i> Delete Student Confirmation</h4>
                </div>
                <div class="card-body p-4 p-sm-5">
                    <div class="alert alert-warning border-0 rounded-3 mb-4" role="alert">
                        <i class="fas fa-exclamation-triangle me-2"></i> Are you sure you want to delete this student record? This action cannot be undone.
                    </div>

                    <form asp-action="Delete" method="post" asp-route-Uuid="@Model.Uuid">
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-dark">Degree Program ID</label>
                            <input asp-for="DegreeProgramId" class="form-control rounded-3 bg-light" readonly />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold text-dark">First Name</label>
                                <input asp-for="FirstName" class="form-control rounded-3 bg-light" readonly />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold text-dark">Last Name</label>
                                <input asp-for="LastName" class="form-control rounded-3 bg-light" readonly />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold text-dark">Email</label>
                                <input asp-for="Email" class="form-control rounded-3 bg-light" readonly />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold text-dark">Phone Number</label>
                                <input asp-for="Phone" class="form-control rounded-3 bg-light" readonly />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold text-dark">Standing</label>
                                <input asp-for="Standing" class="form-control rounded-3 bg-light" readonly />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold text-dark">GPA</label>
                                <input asp-for="GPA" class="form-control rounded-3 bg-light" readonly />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ImageFile" class="form-label fw-semibold text-dark">Identification Picture</label>
                            <input asp-for="ImageFile" type="file" class="form-control rounded-3 bg-light" accept="image/*" disabled />
                        </div>

                        <div class="mb-4">
                            <label class="form-label d-block fw-semibold text-dark mb-2">Enrollment Status</label>
                            <div class="btn-group w-100" role="group" aria-label="Enrollment Status Toggle">
                                <input type="radio" class="btn-check" asp-for="EnrollmentStatus" value="true" id="enrollTrue" autocomplete="off" disabled />
                                <label class="btn btn-outline-success py-2 fw-semibold" for="enrollTrue">Enrolled</label>
                                <input type="radio" class="btn-check" asp-for="EnrollmentStatus" value="false" id="enrollFalse" autocomplete="off" disabled />
                                <label class="btn btn-outline-danger py-2 fw-semibold" for="enrollFalse">Not Enrolled</label>
                            </div>
                        </div>

                        <div class="d-flex align-items-center justify-content-between mt-4">
                            <a asp-action="Index" class="text-muted text-decoration-none fw-semibold"><i class="fas fa-arrow-left me-1"></i> Back to List</a>
                            <input type="submit" value="Confirm Delete" class="btn btn-danger px-4 py-2 rounded-3 fw-bold" />
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>