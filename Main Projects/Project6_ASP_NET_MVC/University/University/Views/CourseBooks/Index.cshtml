@model IEnumerable<University.Application.Dtos.CourseBookDto>

@{
    ViewData["Title"] = "Manage Course Textbooks"; 
    int courseId = ViewBag.CourseId; 
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Manage Stacked Textbooks for Course</h2>
            <p class="text-muted small mb-0">Add or remove multiple books assigned to this course.</p>
        </div>
        <a asp-controller="Courses" asp-action="Index" class="btn btn-outline-secondary px-3 py-2 rounded-3 fw-semibold">
            <i class="fas fa-arrow-left me-1"></i> Back to Courses
        </a>
    </div>

    <!-- Assign Book Card Panel -->
    <div class="card border-0 rounded-4 shadow-sm mb-4">
        <div class="card-body p-4 p-sm-5 bg-white rounded-4">
            <h5 class="fw-bold text-dark mb-3"><i class="fas fa-book-medical me-2 text-indigo" style="color: #4f46e5;"></i> Assign a Book</h5>
            <form asp-action="AssignBook" method="post" class="row g-3 align-items-center">
                <input type="hidden" name="CourseId" value="@courseId" />

                <div class="col-md-9 flex-grow-1">
                    <select name="BookId" class="form-select rounded-3" asp-items="ViewBag.Books" required>
                        <option value="">-- Select a Book to Stack --</option>
                    </select>
                </div>
                <div class="col-md-3 text-md-end">
                    <button type="submit" class="btn btn-indigo text-white px-4 py-2 rounded-3 fw-bold w-100 shadow-sm" style="background-color: #4f46e5;">
                        <i class="fas fa-plus me-1"></i> Add Book
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 rounded-4 shadow-sm overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-uppercase fs-7 text-muted">
                        <tr>
                            <th class="py-3 ps-4" style="width: 100px;">Cover</th>
                            <th class="py-3">Title</th>
                            <th class="py-3">Author</th>
                            <th class="py-3">Price</th>
                            <th class="py-3 pe-4 text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                        @foreach (var cb in Model) 
                        {
                        <tr>
                            <td class="ps-4">
                                @if (!string.IsNullOrEmpty(cb.Book.ImageUrl)) 
                                {
                                <img src="@cb.Book.ImageUrl" alt="Book Cover" class="rounded-3 shadow-sm border" style="width: 50px; height: 70px; object-fit: cover;" />
                                }
                                else
                                {
                                <div class="rounded-3 bg-light border d-flex align-items-center justify-content-center text-muted" style="width: 50px; height: 70px;">
                                    <i class="fas fa-book"></i>
                                </div>
                                }
                            </td>
                            <td class="fw-bold text-dark">@cb.Book.Title</td>
                            <td class="text-muted">@cb.Book.Author</td>
                            <td>
                                <span class="badge bg-success-subtle text-success px-2 py-1 fw-bold fs-6">$@cb.Book.Price.ToString("0.00")</span>
                            </td>
                            <td class="pe-4 text-end">
                                <form asp-action="RemoveBook" method="post" class="d-inline">
                                    <input type="hidden" name="courseId" value="@courseId" />
                                    <input type="hidden" name="bookId" value="@cb.BookId" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-3 px-3 py-1" onclick="return confirm('Are you sure you want to remove this book from the course?');">
                                        <i class="fas fa-trash-alt me-1"></i> Remove
                                    </button>
                                </form>
                            </td>
                        </tr>
                        }
                        }
                        else
                        {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4 fst-italic">No books currently stacked for this course.</td>
                        </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>