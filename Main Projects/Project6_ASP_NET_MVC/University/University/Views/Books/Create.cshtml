@using University.Application.Dtos
@model BookCreateDto

@{
    ViewData["Title"] = "Create Book";
}

<div class="container-fluid px-4 py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-indigo text-white py-3 px-4 rounded-top-4" style="background-color: #4f46e5;">
                    <h4 class="mb-0 fw-bold"><i class="fas fa-book-medical me-2"></i> Create New Book</h4>
                </div>
                <div class="card-body p-4 p-sm-5">
                    <form asp-action="Create" method="post" enctype="multipart/form-data">
                        <div class="text-danger small mb-3" asp-validation-summary="All"></div>

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-semibold text-dark">Title</label>
                            <input asp-for="Title" class="form-control rounded-3" placeholder="Enter book title" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Author" class="form-label fw-semibold text-dark">Author</label>
                                <input asp-for="Author" class="form-control rounded-3" placeholder="Enter author name" />
                                <span asp-validation-for="Author" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Price" class="form-label fw-semibold text-dark">Price</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted border-end-0">$</span>
                                    <input asp-for="Price" class="form-control rounded-end-3" placeholder="0.00" />
                                </div>
                                <span asp-validation-for="Price" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ImageFile" class="form-label fw-semibold text-dark">Book Cover Image</label>
                            <input asp-for="ImageFile" type="file" class="form-control rounded-3" accept="image/*" />
                            <span asp-validation-for="ImageFile" class="text-danger small"></span>
                        </div>

                        <div class="d-flex align-items-center justify-content-between mt-4">
                            <a asp-action="Index" class="text-muted text-decoration-none fw-semibold"><i class="fas fa-arrow-left me-1"></i> Back to List</a>
                            <input type="submit" value="Create Book" class="btn btn-indigo px-4 py-2 rounded-3 fw-bold text-white" style="background-color: #4f46e5;" />
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}