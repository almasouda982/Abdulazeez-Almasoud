@using University.Application.Dtos
@model BookUpdateDto

@{
    ViewData["Title"] = "Delete Book";
}

<div class="container-fluid px-4 py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-danger text-white py-3 px-4 rounded-top-4">
                    <h4 class="mb-0 fw-bold"><i class="fas fa-trash-alt me-2"></i> Delete Book Confirmation</h4>
                </div>
                <div class="card-body p-4 p-sm-5">
                    <div class="alert alert-warning border-0 rounded-3 mb-4" role="alert">
                        <i class="fas fa-exclamation-triangle me-2"></i> Are you sure you want to delete this book? This action cannot be undone.
                    </div>

                    <form asp-action="Delete" asp-route-Uuid="@Model.Uuid" method="post">
                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-semibold text-dark">Title</label>
                            <input asp-for="Title" class="form-control rounded-3 bg-light" readonly />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Author" class="form-label fw-semibold text-dark">Author</label>
                                <input asp-for="Author" class="form-control rounded-3 bg-light" readonly />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Price" class="form-label fw-semibold text-dark">Price</label>
                                <input asp-for="Price" class="form-control rounded-3 bg-light" readonly />
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <div class="mb-4">
                                <label class="form-label fw-semibold text-dark d-block">Cover Image</label>
                                <img src="@Model.ImageUrl" alt="Cover" class="rounded-3 shadow-sm border" style="width: 100px; height: 135px; object-fit: cover;" />
                            </div>
                        }

                        <div class="d-flex align-items-center justify-content-between mt-4">
                            <a asp-action="Index" class="text-muted text-decoration-none fw-semibold"><i class="fas fa-arrow-left me-1"></i> Back to List</a>
                            <input type="submit" value="Confirm Delete" class="btn btn-danger px-4 py-2 rounded-3 fw-bold" />
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>