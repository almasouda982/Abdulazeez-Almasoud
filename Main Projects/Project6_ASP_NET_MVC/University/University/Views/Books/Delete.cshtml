@using University.Application.Dtos
@model BookUpdateDto

@{
    ViewData["Title"] = "Delete Book";
}

<div class="container">
    <h1>Delete Book</h1>
    <h3>Are you sure you want to delete this book?</h3>

    <form asp-action="Delete" asp-route-Uuid="@Model.Uuid" method="post">
        <div class="form-group mb-3">
            <label asp-for="Title" class="control-label"></label>
            <input asp-for="Title" class="form-control" readonly />
        </div>

        <div class="form-group mb-3">
            <label asp-for="Author" class="control-label"></label>
            <input asp-for="Author" class="form-control" readonly />
        </div>

        <div class="form-group mb-3">
            <label asp-for="Price" class="control-label"></label>
            <input asp-for="Price" class="form-control" readonly />
        </div>

        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <div class="form-group mb-3">
                <label class="control-label d-block">Cover Image</label>
                <img src="@Model.ImageUrl" alt="Cover" class="rounded" style="width: 80px; height: 100px; object-fit: cover;" />
            </div>
        }

        <div class="form-group">
            <input type="submit" value="Delete" class="btn btn-danger" />
        </div>
    </form>
    <div class="mt-3">
        <a asp-action="Index">Back to List</a>
    </div>
</div>