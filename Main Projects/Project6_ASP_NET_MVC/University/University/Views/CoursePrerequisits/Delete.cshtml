@using University.Application.Dtos
@model CoursePrerequisiteUpdateDto

@{
    ViewData["Title"] = "Delete Course Prerequisite";
}

<div class="container-fluid px-4 py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-danger text-white py-3 px-4 rounded-top-4">
                    <h4 class="mb-0 fw-bold"><i class="fas fa-trash-alt me-2"></i> Delete Course Prerequisite Confirmation</h4>
                </div>
                <div class="card-body p-4 p-sm-5">
                    <div class="alert alert-warning border-0 rounded-3 mb-4" role="alert">
                        <i class="fas fa-exclamation-triangle me-2"></i> Are you sure you want to delete this prerequisite record? This action cannot be undone.
                    </div>

                    <form asp-action="Delete" asp-route-Uuid="@Model.Uuid" method="post">
                        <div class="mb-3">
                            <label asp-for="MinGradeRequired" class="form-label fw-semibold text-dark">Min Grade Required</label>
                            <input asp-for="MinGradeRequired" class="form-control rounded-3 bg-light" readonly />
                        </div>

                        <div class="mb-3">
                            <label asp-for="CourseId" class="form-label fw-semibold text-dark">Course ID</label>
                            <input asp-for="CourseId" class="form-control rounded-3 bg-light" readonly />
                        </div>

                        <div class="mb-4">
                            <label asp-for="PrerequisiteCourseId" class="form-label fw-semibold text-dark">Prerequisite Course ID</label>
                            <input asp-for="PrerequisiteCourseId" class="form-control rounded-3 bg-light" readonly />
                        </div>

                        <div class="d-flex align-items-center justify-content-between mt-4">
                            <a asp-action="Index" class="text-muted text-decoration-none fw-semibold"><i class="fas fa-arrow-left me-1"></i> Back to List</a>
                            <input type="submit" value="Confirm Delete" class="btn btn-danger px-4 py-2 rounded-3 fw-bold" />
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>