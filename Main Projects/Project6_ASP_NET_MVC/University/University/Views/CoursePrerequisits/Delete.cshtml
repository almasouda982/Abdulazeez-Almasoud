@model CoursePrerequisite

@{
    ViewData["Title"] = "Delete Course Prerequisite";
}

<div class="container">
    <h1>Delete Course Prerequisite</h1>
    <form asp-action="Delete" method="post">





        <div class="form-group">
            <label asp-for="MinGradeRequired" class="control-label"></label>
            <input asp-for="MinGradeRequired" class="form-control" readonly />
        </div>

        <div class="form-group">
            <label asp-for="CourseId" class="control-label"></label>
            <input asp-for="CourseId" class="form-control" readonly />
        </div>

        <div class="form-group">
            <label asp-for="PrerequisiteCourseId" class="control-label"></label>
            <input asp-for="PrerequisiteCourseId" class="form-control" readonly />
        </div>


        <div class="form-group">
            <input type="submit" value="Delete" class="btn btn-danger" />
        </div>
    </form>
    <div>
        <a asp-action="Index">Back to List</a>
    </div>
</div>
