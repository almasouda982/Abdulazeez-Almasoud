@model CoursePrerequisite

@{
    ViewData["Title"] = "Edit Course Prerequisite";
}

<div class="container">
    <h1>Edit Course Prerequisite</h1>
    <form asp-action="Edit" asp-route-Uuid="@Model.Uuid" method="post">

        <div class="text-danger" asp-validation-summary="All">
        </div>

        <div class="form-group">
            <label asp-for="MinGradeRequired" class="control-label"></label>
            <input asp-for="MinGradeRequired" class="form-control" />
            <span class="text-danger" asp-validation-for="MinGradeRequired"></span>

        </div>
        <div class="form-group">
            <label asp-for="CourseId" class="control-label">Course Code</label>
            <select asp-for="CourseId" class="form-control" asp-items="ViewBag.Courses">
                <option value="">-- Select Course --</option>
            </select>
            <span asp-validation-for="CourseId" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="PrerequisiteCourseId" class="control-label"></label>
            <input asp-for="PrerequisiteCourseId" class="form-control" />
            <span class="text-danger" asp-validation-for="PrerequisiteCourseId"></span>

        </div>



        <div class="form-group">
            <input type="submit" value="Update" class="btn btn-warning" />
        </div>
    </form>
    <div>
        <a asp-action="Index">Back to List</a>
    </div>
</div>




@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
