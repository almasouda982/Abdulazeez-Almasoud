@using University.Application.Dtos
@model CoursePrerequisiteUpdateDto

@{
    ViewData["Title"] = "Edit Course Prerequisite";
}

<div class="container-fluid px-4 py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-warning text-dark py-3 px-4 rounded-top-4">
                    <h4 class="mb-0 fw-bold"><i class="fas fa-edit me-2"></i> Edit Course Prerequisite</h4>
                </div>
                <div class="card-body p-4 p-sm-5">
                    <form asp-action="Edit" asp-route-Uuid="@Model.Uuid" method="post">
                        <div class="text-danger small mb-3" asp-validation-summary="All"></div>

                        <div class="mb-3">
                            <label asp-for="MinGradeRequired" class="form-label fw-semibold text-dark">Min Grade Required</label>
                            <input asp-for="MinGradeRequired" class="form-control rounded-3" />
                            <span class="text-danger small" asp-validation-for="MinGradeRequired"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="CourseId" class="form-label fw-semibold text-dark">Course Code</label>
                            <select asp-for="CourseId" class="form-select rounded-3" asp-items="ViewBag.Courses">
                                <option value="">-- Select Course --</option>
                            </select>
                            <span asp-validation-for="CourseId" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="PrerequisiteCourseId" class="form-label fw-semibold text-dark">Prerequisite Course ID</label>
                            <input asp-for="PrerequisiteCourseId" class="form-control rounded-3" />
                            <span class="text-danger small" asp-validation-for="PrerequisiteCourseId"></span>
                        </div>

                        <div class="d-flex align-items-center justify-content-between mt-4">
                            <a asp-action="Index" class="text-muted text-decoration-none fw-semibold"><i class="fas fa-arrow-left me-1"></i> Back to List</a>
                            <input type="submit" value="Update Prerequisite" class="btn btn-warning px-4 py-2 rounded-3 fw-bold text-dark" />
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}