@using University.Application.Dtos
@model EnrollmentUpdateDto
@{
    ViewData["Title"] = "Edit Enrollment";
}

<div class="container-fluid px-4 py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-warning text-dark py-3 px-4 rounded-top-4">
                    <h4 class="mb-0 fw-bold"><i class="fas fa-edit me-2"></i> Edit Enrollment</h4>
                </div>
                <div class="card-body p-4 p-sm-5">
                    <form asp-action="Edit" asp-route-Uuid="@Model.Uuid" method="post" enctype="multipart/form-data">
                        <div class="text-danger small mb-3" asp-validation-summary="All"></div>

                        <div class="mb-3">
                            <label asp-for="StudentId" class="form-label fw-semibold text-dark">Student</label>
                            <select asp-for="StudentId" class="form-select rounded-3" asp-items="ViewBag.Students">
                                <option value="">-- Select Student --</option>
                            </select>
                            <span asp-validation-for="StudentId" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="CourseSectionId" class="form-label fw-semibold text-dark">Course Section</label>
                            <select asp-for="CourseSectionId" class="form-select rounded-3" asp-items="ViewBag.CourseSections">
                                <option value="">-- Select Course Section --</option>
                            </select>
                            <span asp-validation-for="CourseSectionId" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold text-dark">Final Grade</label>
                                <input asp-for="FinalGrade" class="form-control rounded-3" />
                                <span asp-validation-for="FinalGrade" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold text-dark">Letter Grade Points</label>
                                <input asp-for="LetterGradePoints" class="form-control rounded-3" />
                                <span asp-validation-for="LetterGradePoints" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DocumentFile" class="form-label fw-semibold text-dark">Transcript PDF</label>
                            <input asp-for="DocumentFile" type="file" class="form-control rounded-3" accept=".pdf" />
                            <span asp-validation-for="DocumentFile" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label d-block fw-semibold text-dark mb-2">Status</label>
                            <div class="btn-group w-100" role="group" aria-label="Enrollment Status Toggle">
                                <input type="radio" class="btn-check" asp-for="Status" value="true" id="enrollTrue" autocomplete="off" />
                                <label class="btn btn-outline-success py-2 fw-semibold" for="enrollTrue">Enrolled</label>
                                <input type="radio" class="btn-check" asp-for="Status" value="false" id="enrollFalse" autocomplete="off" />
                                <label class="btn btn-outline-danger py-2 fw-semibold" for="enrollFalse">Not Enrolled</label>
                            </div>
                            <span asp-validation-for="Status" class="text-danger small d-block mt-1"></span>
                        </div>

                        <div class="d-flex align-items-center justify-content-between mt-4">
                            <a asp-action="Index" class="text-muted text-decoration-none fw-semibold"><i class="fas fa-arrow-left me-1"></i> Back to List</a>
                            <input type="submit" value="Update Enrollment" class="btn btn-warning px-4 py-2 rounded-3 fw-bold text-dark" />
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}