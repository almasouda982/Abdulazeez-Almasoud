@using University.Application.Dtos
@model EnrollmentUpdateDto

@{
    ViewData["Title"] = "Delete Enrollment";
}

<div class="container-fluid px-4 py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-danger text-white py-3 px-4 rounded-top-4">
                    <h4 class="mb-0 fw-bold"><i class="fas fa-trash-alt me-2"></i> Delete Enrollment Confirmation</h4>
                </div>
                <div class="card-body p-4 p-sm-5">
                    <div class="alert alert-warning border-0 rounded-3 mb-4" role="alert">
                        <i class="fas fa-exclamation-triangle me-2"></i> Are you sure you want to delete this enrollment record? This action cannot be undone.
                    </div>

                    <form asp-action="Delete" asp-route-Uuid="@Model.Uuid" method="post">
                        <div class="mb-3">
                            <label asp-for="StudentId" class="form-label fw-semibold text-dark">Student ID</label>
                            <input asp-for="StudentId" class="form-control rounded-3 bg-light" readonly />
                        </div>

                        <div class="mb-3">
                            <label asp-for="CourseSectionId" class="form-label fw-semibold text-dark">Course Section ID</label>
                            <input asp-for="CourseSectionId" class="form-control rounded-3 bg-light" readonly />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FinalGrade" class="form-label fw-semibold text-dark">Final Grade</label>
                                <input asp-for="FinalGrade" class="form-control rounded-3 bg-light" readonly />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="LetterGradePoints" class="form-label fw-semibold text-dark">Letter Grade Points</label>
                                <input asp-for="LetterGradePoints" class="form-control rounded-3 bg-light" readonly />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DocumentFile" class="form-label fw-semibold text-dark">Transcript PDF</label>
                            <input asp-for="DocumentFile" type="file" class="form-control rounded-3 bg-light" accept=".pdf" disabled />
                        </div>

                        <div class="mb-4">
                            <label class="form-label d-block fw-semibold text-dark mb-2">Status</label>
                            <div class="btn-group w-100" role="group" aria-label="Enrollment Status Toggle">
                                <input type="radio" class="btn-check" asp-for="Status" value="true" id="enrollTrue" autocomplete="off" disabled />
                                <label class="btn btn-outline-success py-2 fw-semibold" for="enrollTrue">Enrolled</label>
                                <input type="radio" class="btn-check" asp-for="Status" value="false" id="enrollFalse" autocomplete="off" disabled />
                                <label class="btn btn-outline-danger py-2 fw-semibold" for="enrollFalse">Not Enrolled</label>
                            </div>
                        </div>

                        <div class="d-flex align-items-center justify-content-between mt-4">
                            <a asp-action="Index" class="text-muted text-decoration-none fw-semibold"><i class="fas fa-arrow-left me-1"></i> Back to List</a>
                            <input type="submit" value="Confirm Delete" class="btn btn-danger px-4 py-2 rounded-3 fw-bold" />
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>