@using University.Application.Dtos
@model IEnumerable<EnrollmentDto>

@{
    ViewData["Title"] = "Enrollments Management";
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Enrollments Management</h2>
            <p class="text-muted small mb-0">Track student class registrations, grades, and transcripts.</p>
        </div>
        <a asp-action="Create" class="btn btn-indigo text-white px-3 py-2 rounded-3 fw-bold shadow-sm" style="background-color: #4f46e5;">
            <i class="fas fa-plus-circle me-2"></i> New Enrollment
        </a>
    </div>

    <div class="card border-0 rounded-4 shadow-sm overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-uppercase fs-7 text-muted">
                        <tr>
                            <th class="py-3 ps-4">Id</th>
                            <th class="py-3">Student Last Name</th>
                            <th class="py-3">Section Code</th>
                            <th class="py-3">Final Grade</th>
                            <th class="py-3">Points</th>
                            <th class="py-3">Transcript</th>
                            <th class="py-3">Status</th>
                            <th class="py-3 pe-4 text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var enrollment in Model)
                        {
                            string gradeStr = enrollment.FinalGrade?.Trim().ToUpper() ?? "";
                            string badgeColorClass = "bg-danger-subtle text-danger";
                            if (new[] { "A+", "A", "A-", "B+", "B" }.Contains(gradeStr))
                            {
                                badgeColorClass = "bg-success-subtle text-success";
                            }
                            else if (new[] { "B-", "C+", "C", "C-" }.Contains(gradeStr))
                            {
                                badgeColorClass = "bg-warning-subtle text-warning ";
                            }

                            <tr>
                                <td class="ps-4 fw-semibold text-secondary">@enrollment.Id</td>
                                <td class="fw-bold text-dark">@enrollment.LastName</td>
                                <td><span class="badge px-2 py-1 rounded-2" style="background-color: rgba(79, 70, 229, 0.1); color: #4f46e5;">@enrollment.SectionNumber</span></td>
                                <td>
                                    @if (!string.IsNullOrEmpty(enrollment.FinalGrade))
                                    {
                                        <span class="badge @badgeColorClass px-2 py-1 fw-bold">@enrollment.FinalGrade</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">N/A</span>
                                    }
                                </td>
                                <td class="fw-semibold">@enrollment.LetterGradePoints</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(enrollment.DocumentUrl))
                                    {
                                        <a href="@enrollment.DocumentUrl" target="_blank" class="text-decoration-none fw-bold" style="color: #4f46e5;">
                                            <i class="fas fa-file-pdf me-1 text-danger"></i> @(enrollment.LastName ?? "Student").transcript
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small fst-italic">No Transcript</span>
                                    }
                                </td>
                                <td>
                                    @if (enrollment.Status)
                                    {
                                        <span class="badge bg-success-subtle text-success px-2 py-1 rounded-pill">Enrolled</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger px-2 py-1 rounded-pill">Not Enrolled</span>
                                    }
                                </td>
                                <td class="pe-4 text-end">
                                    <div class="btn-group" role="group">
                                        <a asp-action="Edit" asp-route-Uuid="@enrollment.Uuid" class="btn btn-sm btn-outline-warning rounded-start-3 px-2 py-1" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-Uuid="@enrollment.Uuid" class="btn btn-sm btn-outline-danger rounded-end-3 px-2 py-1" title="Delete">
                                            <i class="fas fa-trash-alt"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>