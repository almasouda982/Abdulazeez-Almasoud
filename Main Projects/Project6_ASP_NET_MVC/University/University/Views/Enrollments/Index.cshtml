@using University.Dtos
@model IEnumerable<EnrollmentDto>

<div class="container">

    <h1>Enrollment</h1>

    <div class="text-end">
        <a asp-action="Create" class="btn btn-primary mb-3">New Enrollment</a>
    </div>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                @* <th>Student Id</th>
                <th>Course Section Id</th> *@
                <th>Student Last Name</th>
                <th>Course Section Code</th>
                <th>Final Grade</th>
                <th>Letter Grade Points</th>
                <th>Status</th>
                <th>Actions</th>

            </tr>
        </thead>
        <tbody>
            @foreach (var enrollment in Model)
            {

                <tr>
                    <td>@enrollment.Id</td>
                    <td>@enrollment.LastName</td>
                    <td>@enrollment.SectionNumber</td>
                    <td>@enrollment.FinalGrade</td>
                    <td>@enrollment.LetterGradePoints</td>
                    <td>@(enrollment.Status ? "Enrolled" : "Not Enrolled")</td>
                    <td>
                        <a asp-action="Edit" asp-route-Uuid="@enrollment.Uuid" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-action="Delete" asp-route-Uuid="@enrollment.Uuid" class="btn btn-sm btn-danger">Delete</a>

                    </td>

                </tr>

            }


        </tbody>

    </table>
</div>
