@using University.Application.Dtos
@model WaitlistEntryCreateDto
@{
    ViewData["Title"] = "Create Waitlist Entry";
}

<div class="container-fluid px-4 py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-indigo text-white py-3 px-4 rounded-top-4" style="background-color: #4f46e5;">
                    <h4 class="mb-0 fw-bold"><i class="fas fa-clock me-2"></i> Create Waitlist Entry</h4>
                </div>
                <div class="card-body p-4 p-sm-5">
                    <form asp-action="Create" method="post">
                        <div class="text-danger small mb-3" asp-validation-summary="All"></div>

                        <div class="mb-3">
                            <label asp-for="StudentId" class="form-label fw-semibold text-dark">Student Last Name</label>
                            <select asp-for="StudentId" class="form-select rounded-3" asp-items="ViewBag.Students">
                                <option value="">-- Select Student --</option>
                            </select>
                            <span asp-validation-for="StudentId" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="CourseSectionId" class="form-label fw-semibold text-dark">Course Section Code</label>
                            <select asp-for="CourseSectionId" class="form-select rounded-3" asp-items="ViewBag.CourseSections">
                                <option value="">-- Select Course Section --</option>
                            </select>
                            <span asp-validation-for="CourseSectionId" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-dark">Position</label>
                            <input asp-for="Position" class="form-control rounded-3" placeholder="e.g. 1" />
                            <span asp-validation-for="Position" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold text-dark">Offered At</label>
                                <input asp-for="OfferedAt" class="form-control rounded-3" placeholder="Date & Time" />
                                <span asp-validation-for="OfferedAt" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold text-dark">Expires At</label>
                                <input asp-for="ExpiresAt" class="form-control rounded-3" placeholder="Date & Time" />
                                <span asp-validation-for="ExpiresAt" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label d-block fw-semibold text-dark mb-2">Status</label>
                            <div class="btn-group w-100" role="group" aria-label="Status Toggle">
                                <input type="radio" class="btn-check" asp-for="Status" value="true" id="enrollTrue" autocomplete="off" />
                                <label class="btn btn-outline-success py-2 fw-semibold" for="enrollTrue">Seat Offered</label>
                                <input type="radio" class="btn-check" asp-for="Status" value="false" id="enrollFalse" autocomplete="off" />
                                <label class="btn btn-outline-warning py-2 fw-semibold text-dark" for="enrollFalse">Waiting</label>
                            </div>
                            <span asp-validation-for="Status" class="text-danger small d-block mt-1"></span>
                        </div>

                        <div class="d-flex align-items-center justify-content-between mt-4">
                            <a asp-action="Index" class="text-muted text-decoration-none fw-semibold"><i class="fas fa-arrow-left me-1"></i> Back to List</a>
                            <input type="submit" value="Create Entry" class="btn btn-indigo px-4 py-2 rounded-3 fw-bold text-white" style="background-color: #4f46e5;" />
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}