@model WaitlistEntry

@{
    ViewData["Title"] = "Delete Waitlist Entry";
}

<div class="container">
    <h1>Delete Waitlist Entry</h1>
    <form asp-action="Delete" method="post">





        <div class="form-group">
            <label class="control-label">Student Id</label>
            <input asp-for="StudentId" class="form-control" readonly />
        </div>
        <div class="form-group">
            <label class="control-label">Course Section Id</label>
            <input asp-for="CourseSectionId" class="form-control" readonly />
        </div>
        <div class="form-group">
            <label class="control-label">Position</label>
            <input asp-for="Position" class="form-control" readonly />
        </div>
        <div class="form-group">
            <label class="control-label">Offered At</label>
            <input asp-for="OfferedAt" class="form-control" readonly />
        </div>
        <div class="form-group">
            <label class="control-label">ExpiresAt</label>
            <input asp-for="ExpiresAt" class="form-control" placeholder="Standing Position" readonly />
        </div>
        <div class="form-group">
            <label class="control-label d-block mb-2">Status</label>
            <div class="btn-group" role="group" aria-label="Enrollment Status Toggle">
                <input type="radio" class="btn-check" asp-for="Status" value="true" id="enrollTrue" autocomplete="off" readonly/>
                <label class="btn btn-outline-success" for="enrollTrue">Seat Offered</label>
                <input type="radio" class="btn-check" asp-for="Status" value="false" id="enrollFalse" autocomplete="off" readonly/>
                <label class="btn btn-outline-danger" for="enrollFalse">Waiting</label>
            </div>
        </div>




        <div class="form-group">
            <input type="submit" value="Delete" class="btn btn-danger" />
        </div>
    </form>
    <div>
        <a asp-action="Index">Back to List</a>
    </div>
</div>
