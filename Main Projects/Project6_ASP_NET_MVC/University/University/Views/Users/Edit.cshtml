@using University.Domain.Models
@model User
@{
    ViewData["Title"] = "Edit User";
}

<div class="container-fluid px-4 py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-warning text-dark py-3 px-4 rounded-top-4">
                    <h4 class="mb-0 fw-bold"><i class="fas fa-user-edit me-2"></i> Edit User Profile</h4>
                </div>
                <div class="card-body p-4 p-sm-5">
                    <form asp-action="Edit" method="post" asp-route-Uuid="@Model.Uuid">
                        <input asp-for="Id" type="hidden" />

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Name" class="form-label fw-semibold text-dark">Name</label>
                                <input asp-for="Name" class="form-control rounded-3" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="UserName" class="form-label fw-semibold text-dark">Username</label>
                                <input asp-for="UserName" class="form-control rounded-3" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold text-dark">Email Address</label>
                            <input asp-for="Email" type="email" class="form-control rounded-3" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-dark">New Password</label>
                            <input name="Password" type="password" class="form-control rounded-3" placeholder="••••••••" />
                            <small class="text-muted d-block mt-1">
                                Leave empty to keep current password
                            </small>
                        </div>

                        <div class="form-check mb-4 p-3 bg-light rounded-3 border">
                            <input asp-for="IsLocked" class="form-check-input ms-0 me-2" id="isLockedCheck" />
                            <label asp-for="IsLocked" class="form-check-label fw-semibold text-dark" for="isLockedCheck">
                                Locked Account
                            </label>
                        </div>

                        <div class="d-flex align-items-center justify-content-between mt-4">
                            <a asp-action="Index" class="text-muted text-decoration-none fw-semibold"><i class="fas fa-arrow-left me-1"></i> Back</a>
                            <button type="submit" class="btn btn-warning px-4 py-2 rounded-3 fw-bold text-dark">
                                Update User
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>