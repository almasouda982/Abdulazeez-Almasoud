@using University.Domain.Models
@model User

@{
    ViewData["Title"] = "Delete User";
}

<div class="container-fluid px-4 py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-danger text-white py-3 px-4 rounded-top-4">
                    <h4 class="mb-0 fw-bold"><i class="fas fa-user-slash me-2"></i> Delete User Confirmation</h4>
                </div>
                <div class="card-body p-4 p-sm-5">
                    <div class="alert alert-warning border-0 rounded-3 mb-4" role="alert">
                        <i class="fas fa-exclamation-triangle me-2"></i> Are you sure you want to delete this user? This action cannot be undone.
                    </div>

                    <div class="mb-3">
                        <strong class="text-dark">Name:</strong>
                        <div class="p-2 bg-light rounded-3 border mt-1">@Model.Name</div>
                    </div>

                    <div class="mb-3">
                        <strong class="text-dark">Username:</strong>
                        <div class="p-2 bg-light rounded-3 border mt-1">@Model.UserName</div>
                    </div>

                    <div class="mb-4">
                        <strong class="text-dark">Email:</strong>
                        <div class="p-2 bg-light rounded-3 border mt-1">@Model.Email</div>
                    </div>

                    <form asp-action="Delete" asp-route-Uuid="@Model.Id" method="post">
                        <div class="d-flex align-items-center justify-content-between mt-4">
                            <a asp-action="Index" class="text-muted text-decoration-none fw-semibold"><i class="fas fa-arrow-left me-1"></i> Cancel</a>
                            <button type="submit" class="btn btn-danger px-4 py-2 rounded-3 fw-bold">
                                Confirm Delete
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>