@model IEnumerable<University.Models.User>
@{
    ViewData["Title"] = "Users";
    int count = 1;
}

<h1>Users</h1>

<a asp-action="Create" class="btn btn-primary mb-3">
    Create New User
</a>

<table class="table table-striped">

    <thead>
        <tr>
            <th>#</th>
            <th>Name</th>
            <th>Username</th>
            <th>Email</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var user in Model)
        {
            <tr>
                <td>@count</td>

                <td>@user.Name</td>

                <td>@user.UserName</td>

                <td>@user.Email</td>

                <td>
                    @if (user.IsLocked)
                    {
                        <span class="badge bg-danger">
                            Locked
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-success">
                            Active
                        </span>
                    }
                </td>

                <td>
                    <a asp-action="Details"
                       asp-route-id="@user.Id"
                       class="btn btn-info">
                        Details
                    </a>

                    <a asp-action="Edit"
                       asp-route-id="@user.Id"
                       class="btn btn-warning">
                        Edit
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@user.Id"
                       class="btn btn-danger">
                        Delete
                    </a>
                </td>
            </tr>

            count++;
        }

    </tbody>

</table>