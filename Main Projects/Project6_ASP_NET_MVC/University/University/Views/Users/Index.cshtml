@model IEnumerable<University.Domain.Models.User>
@{
    ViewData["Title"] = "Users Management";
    int count = 1;
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Users Directory</h2>
            <p class="text-muted small mb-0">Manage system administrators, permissions, and account statuses.</p>
        </div>
        <a asp-action="Create" class="btn btn-indigo text-white px-3 py-2 rounded-3 fw-bold shadow-sm" style="background-color: #4f46e5;">
            <i class="fas fa-user-plus me-2"></i> Create New User
        </a>
    </div>

    <div class="card border-0 rounded-4 shadow-sm overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-uppercase fs-7 text-muted">
                        <tr>
                            <th class="py-3 ps-4" style="width: 60px;">#</th>
                            <th class="py-3">Name</th>
                            <th class="py-3">Username</th>
                            <th class="py-3">Email</th>
                            <th class="py-3">Status</th>
                            <th class="py-3 pe-4 text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold text-secondary">@count</td>
                                <td class="fw-bold text-dark">@user.Name</td>
                                <td class="text-muted">@user.UserName</td>
                                <td class="text-muted">@user.Email</td>
                                <td>
                                    @if (user.IsLocked)
                                    {
                                        <span class="badge bg-danger-subtle text-danger px-2 py-1 rounded-pill fw-bold">
                                            Locked
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success px-2 py-1 rounded-pill fw-bold">
                                            Active
                                        </span>
                                    }
                                </td>
                                <td class="pe-4 text-end">
                                    <div class="btn-group" role="group">
                                        <a asp-action="Edit" asp-route-Uuid="@user.Uuid" class="btn btn-sm btn-outline-warning rounded-start-3 px-2 py-1" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-Uuid="@user.Uuid" class="btn btn-sm btn-outline-danger rounded-end-3 px-2 py-1" title="Delete">
                                            <i class="fas fa-trash-alt"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>

                            count++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>